# SCA API base URL. Auth uses httpOnly cookies, so this origin must appear in
# the backend's CORS_ALLOWED_ORIGINS, and this app's origin in ADMIN_ORIGINS.
VITE_API_URL=http://localhost:8080

# Public website address, used for "view on site" links in moderation desks.
# Leave empty to show titles without links.
VITE_SITE_URL=
